<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tutto il tema dell'app sta qui; Theme.Arkhiva aggiunge solo, da API 31
         in su, lo sfondo dello splash di sistema (values-v31/themes.xml). -->
    <style name="Base.Theme.Arkhiva" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Colori della starting window, cioè dei pochi istanti prima di
             onCreate: sono quelli di `synthwave`, il tema di default della WebUI.
             Da onCreate in poi finestra, barre, loading view ed error view
             prendono i colori dell'ultimo tema scelto (applyBootPalette). -->
        <item name="android:statusBarColor">@color/arkhiva_dark</item>
        <item name="android:navigationBarColor">@color/arkhiva_dark</item>
        <!-- Il default di AppCompat.Light è quasi bianco e lampeggia nella
             starting window, prima che la loading view dipinga. -->
        <item name="android:windowBackground">@color/arkhiva_dark</item>
    </style>

    <style name="Theme.Arkhiva" parent="Base.Theme.Arkhiva" />
</resources>
